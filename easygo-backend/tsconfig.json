{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "sourceMap": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "generated/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "prisma"
  ]
}