# Copy this file to `.env` and fill in the values.
#
# `.env` is not committed. The repository only carries the shape of the file so
# a fresh clone knows what it has to provide.

# The PostgreSQL database the API reads and writes.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/easygo_db"

# Signs the access tokens issued at login. Any long random string works here;
# changing it invalidates the tokens already handed out.
JWT_SECRET="replace-this-with-a-long-random-string"

# Firebase Cloud Messaging, which sends a push to a device so a notification
# arrives without the app being open. Optional: without it the API still writes
# in-app notifications, it just cannot reach a phone.
#
# To set it up, in the Firebase console:
#   Project settings > Service accounts > Firebase Admin SDK > Generate new key
#
# Save the downloaded file as `secrets/firebase-service-account.json`. The
# `secrets/` directory is git-ignored, in full, on purpose — that key is a
# password to the whole Firebase project, not a configuration value.
#
# An absolute path is safest. A relative one is resolved against the directory
# the process was started in, which is `easygo-backend` for `npm run dev`.
GOOGLE_APPLICATION_CREDENTIALS="C:/Users/you/Desktop/easyGO/easygo-backend/secrets/firebase-service-account.json"
