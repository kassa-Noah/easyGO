# Copy this file to `.env` and fill in the values.
#
# `.env` is not committed. The repository only carries the shape of the file so
# a fresh clone knows what it has to provide.

# The PostgreSQL database the API reads and writes.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/easygo_db"

# Signs the access tokens issued at login. Any long random string works here;
# changing it invalidates the tokens already handed out.
JWT_SECRET="replace-this-with-a-long-random-string"
