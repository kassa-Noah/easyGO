node_modules
# Keep environment variables out of version control. `.env.example` is the one
# that is committed, so a clone can see what it has to provide.
.env

# Service account keys and other credentials.
#
# A Firebase service account key is not a configuration file. It is a password to
# the whole Firebase project: whoever holds it can send messages to every user
# and change settings without going through the console. It is ignored as a
# whole directory rather than by filename so that a key dropped in later is
# covered without anyone having to remember to edit this file.
/secrets/

# Compiled output. `npm run build` produces dist/ and `npm start` consumes it,
# so it is a build artifact rather than source.
/dist/

# The generated Prisma client. `npm install` regenerates it through the
# postinstall hook, and `npm run generate` does it on demand, so it is output
# rather than source. It used to be committed, which re-recorded the whole
# client in git every time the schema changed.
/generated/

# The client used to be written to src/generated/prisma. This covers that older
# location in case a build still emits it.
/src/generated/prisma

# The Prisma skills are installed by the skills CLI (see skills-lock.json) into
# .agents/skills, and that is the only real copy. .claude/skills and
# .windsurf/skills hold NTFS junctions pointing at it so each editor finds its
# own path, but git follows a junction and records the files as if they were
# separate, which duplicated 142 paths in the repository. The junctions stay on
# disk; only the duplicate paths are untracked.
/.claude/skills/
/.windsurf/skills/
