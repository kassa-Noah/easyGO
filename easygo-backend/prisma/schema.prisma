generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  CUSTOMER
  AGENCY_STAFF
  ADMIN
}

enum AgencyStaffRole {
  MANAGER
  AGENT
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH
  CARD
  SIMULATED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum JourneyStatus {
  PENDING
  CONFIRMED
  PICKUP_ASSIGNED
  PICKUP_IN_PROGRESS
  AT_DEPARTURE_AGENCY
  INTERURBAN_IN_PROGRESS
  AT_ARRIVAL_AGENCY
  DROPOFF_ASSIGNED
  DROPOFF_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaxiSegmentType {
  HOME_TO_DEPARTURE_AGENCY
  ARRIVAL_AGENCY_TO_DESTINATION
}

enum TaxiAssignmentStatus {
  PENDING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  PASSENGER_PICKED_UP
  COMPLETED
  CANCELLED
}

enum TaxiProviderType {
  INTERNAL
  EXTERNAL
  SIMULATED
}

enum LuggageStatus {
  REGISTERED
  RECEIVED_AT_AGENCY
  LOADED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION_AGENCY
  READY_FOR_COLLECTION
  DELIVERED
  LOST
}

enum ParcelStatus {
  REGISTERED
  RECEIVED_AT_ORIGIN_AGENCY
  LOADED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION_AGENCY
  READY_FOR_COLLECTION
  COLLECTED
  DELIVERED
  LOST
  CANCELLED
}

enum NotificationType {
  BOOKING
  PAYMENT
  TICKET
  TAXI
  TRIP
  LUGGAGE
  PARCEL
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

// ======================================================
// USER
// ======================================================

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings        Booking[]
  journeys        DoorToDoorJourney[]
  sentParcels     Parcel[]            @relation("ParcelSender")
  receivedParcels Parcel[]            @relation("ParcelRecipient")
  notifications   Notification[]
  reviews         Review[]
  agencyStaff     AgencyStaff?

  luggageUpdates LuggageTrackingEvent[]
  parcelUpdates  ParcelTrackingEvent[]

  @@index([email])
  @@index([phone])
}

// ======================================================
// AGENCY
// ======================================================

model Agency {
  id          String  @id @default(uuid())
  name        String
  description String?
  phone       String?
  email       String?
  logoUrl     String?
  website     String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches AgencyBranch[]
  staff    AgencyStaff[]
  vehicles Vehicle[]
  trips    Trip[]
  reviews  Review[]

  @@index([name])
}

// ======================================================
// AGENCY STAFF
// ======================================================

model AgencyStaff {
  id       String          @id @default(uuid())
  role     AgencyStaffRole @default(AGENT)
  isActive Boolean         @default(true)

  userId   String @unique
  agencyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

// ======================================================
// AGENCY BRANCH
// ======================================================

model AgencyBranch {
  id      String @id @default(uuid())
  name    String
  city    String
  address String

  latitude  Float?
  longitude Float?

  phone    String?
  isActive Boolean @default(true)

  agencyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  routesAsOrigin      Route[] @relation("RouteOrigin")
  routesAsDestination Route[] @relation("RouteDestination")

  parcelsAsOrigin      Parcel[] @relation("ParcelOriginBranch")
  parcelsAsDestination Parcel[] @relation("ParcelDestinationBranch")

  @@index([agencyId])
  @@index([city])
}

// ======================================================
// ROUTE
// ======================================================

model Route {
  id String @id @default(uuid())

  originBranchId      String
  destinationBranchId String

  distanceKm               Float?
  estimatedDurationMinutes Int?

  baseFare Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originBranch      AgencyBranch @relation("RouteOrigin", fields: [originBranchId], references: [id])
  destinationBranch AgencyBranch @relation("RouteDestination", fields: [destinationBranchId], references: [id])

  trips Trip[]

  @@unique([originBranchId, destinationBranchId])
  @@index([originBranchId])
  @@index([destinationBranchId])
}

// ======================================================
// VEHICLE
// ======================================================

model Vehicle {
  id String @id @default(uuid())

  registrationNumber String  @unique
  model              String?
  brand              String?
  capacity           Int

  isActive Boolean @default(true)

  agencyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  trips Trip[]

  @@index([agencyId])
}

// ======================================================
// TRIP
// ======================================================

model Trip {
  id String @id @default(uuid())

  departureTime DateTime
  arrivalTime   DateTime?

  price Decimal @db.Decimal(12, 2)

  totalSeats     Int
  availableSeats Int

  status TripStatus @default(SCHEDULED)

  agencyId  String
  routeId   String
  vehicleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency  Agency   @relation(fields: [agencyId], references: [id])
  route   Route    @relation(fields: [routeId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  bookings Booking[]
  parcels  Parcel[]
  reviews  Review[]

  @@index([agencyId])
  @@index([routeId])
  @@index([departureTime])
  @@index([status])
}

// ======================================================
// BOOKING
// ======================================================

model Booking {
  id String @id @default(uuid())

  bookingReference String @unique

  numberOfSeats Int @default(1)

  tripAmount        Decimal @db.Decimal(12, 2)
  taxiPickupAmount  Decimal @default(0) @db.Decimal(12, 2)
  taxiDropoffAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  status BookingStatus @default(PENDING)

  userId String
  tripId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])

  journey  DoorToDoorJourney?
  payments Payment[]
  ticket   Ticket?
  luggage  Luggage[]

  @@index([userId])
  @@index([tripId])
  @@index([status])
}

// ======================================================
// DOOR-TO-DOOR JOURNEY
// ======================================================

model DoorToDoorJourney {
  id String @id @default(uuid())

  pickupAddress String

  pickupLatitude  Float?
  pickupLongitude Float?

  destinationAddress String

  destinationLatitude  Float?
  destinationLongitude Float?

  status JourneyStatus @default(PENDING)

  bookingId String @unique
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  taxiAssignments TaxiAssignment[]

  @@index([userId])
  @@index([status])
}

// ======================================================
// TAXI PROVIDER
// ======================================================

model TaxiProvider {
  id String @id @default(uuid())

  name String
  type TaxiProviderType

  apiBaseUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TaxiAssignment[]
}

// ======================================================
// TAXI ASSIGNMENT
// ======================================================

model TaxiAssignment {
  id String @id @default(uuid())

  segmentType TaxiSegmentType

  status TaxiAssignmentStatus @default(PENDING)

  driverName  String?
  driverPhone String?

  vehicleRegistration String?
  vehicleDescription  String?

  externalReference String?

  pickupAddress  String
  dropoffAddress String

  estimatedFare Decimal? @db.Decimal(12, 2)
  finalFare     Decimal? @db.Decimal(12, 2)

  assignedAt  DateTime?
  completedAt DateTime?

  journeyId  String
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey  DoorToDoorJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  provider TaxiProvider      @relation(fields: [providerId], references: [id])

  @@index([journeyId])
  @@index([providerId])
  @@index([status])
}

// ======================================================
// PAYMENT
// ======================================================

model Payment {
  id String @id @default(uuid())

  transactionReference String @unique

  amount Decimal @db.Decimal(12, 2)

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  providerReference String?

  paidAt DateTime?

  bookingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

// ======================================================
// DIGITAL TICKET
// ======================================================

model Ticket {
  id String @id @default(uuid())

  ticketNumber String @unique
  qrCodeData   String @unique

  status TicketStatus @default(ACTIVE)

  issuedAt DateTime  @default(now())
  usedAt   DateTime?

  bookingId String @unique

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ======================================================
// PASSENGER LUGGAGE
// ======================================================

model Luggage {
  id String @id @default(uuid())

  trackingNumber String @unique

  description String?

  weightKg Float?

  status LuggageStatus @default(REGISTERED)

  progressPercentage Int @default(0)

  bookingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  trackingEvents LuggageTrackingEvent[]

  @@index([bookingId])
  @@index([trackingNumber])
  @@index([status])
}

// ======================================================
// LUGGAGE TRACKING EVENT
// ======================================================

model LuggageTrackingEvent {
  id String @id @default(uuid())

  status LuggageStatus

  progressPercentage Int

  location String?

  description String?

  luggageId String

  updatedById String?

  createdAt DateTime @default(now())

  luggage   Luggage @relation(fields: [luggageId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id])

  @@index([luggageId])
  @@index([createdAt])
}

// ======================================================
// PARCEL
// ======================================================

model Parcel {
  id String @id @default(uuid())

  trackingNumber String @unique

  description String

  weightKg Float?

  recipientName  String
  recipientPhone String

  status ParcelStatus @default(REGISTERED)

  progressPercentage Int @default(0)

  shipmentPrice Decimal? @db.Decimal(12, 2)

  senderId String

  recipientUserId String?

  originBranchId      String
  destinationBranchId String

  tripId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender        User  @relation("ParcelSender", fields: [senderId], references: [id])
  recipientUser User? @relation("ParcelRecipient", fields: [recipientUserId], references: [id])

  originBranch      AgencyBranch @relation("ParcelOriginBranch", fields: [originBranchId], references: [id])
  destinationBranch AgencyBranch @relation("ParcelDestinationBranch", fields: [destinationBranchId], references: [id])

  trip Trip? @relation(fields: [tripId], references: [id])

  trackingEvents ParcelTrackingEvent[]

  @@index([senderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([originBranchId])
  @@index([destinationBranchId])
}

// ======================================================
// PARCEL TRACKING EVENT
// ======================================================

model ParcelTrackingEvent {
  id String @id @default(uuid())

  status ParcelStatus

  progressPercentage Int

  location String?

  description String?

  parcelId String

  updatedById String?

  createdAt DateTime @default(now())

  parcel    Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation(fields: [updatedById], references: [id])

  @@index([parcelId])
  @@index([createdAt])
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id String @id @default(uuid())

  title   String
  message String

  type NotificationType

  status NotificationStatus @default(UNREAD)

  userId String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ======================================================
// REVIEW
// ======================================================

model Review {
  id String @id @default(uuid())

  rating Int

  comment String?

  userId   String
  agencyId String
  tripId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])

  @@unique([userId, tripId])
  @@index([userId])
  @@index([agencyId])
}
